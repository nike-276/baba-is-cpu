# Scenario 19: WEAK objects are destroyed whenever they share a tile with any
# other non-text object (static overlap). Post-CP-11 WEAK is arrival-agnostic:
# if BABA IS YOU and ROCK IS WEAK, moving BABA onto ROCK still destroys ROCK
# on the same tick — and ROCK would also die if something teleported/spawned
# onto its tile. This test keeps the "move onto" form; see scenario 120 for
# the spawn-overlap case.

[setup]
version 1
name "weak destroyed by any tile-overlap"

text 0 0 baba
text 1 0 is
text 2 0 you

text 0 1 rock
text 1 1 is
text 2 1 weak

object 5 5 baba right
object 6 5 rock right

[inputs]
input right

[expected]
at 6 5 baba
not_at 6 5 rock
count rock 0
tick 1
not_won
