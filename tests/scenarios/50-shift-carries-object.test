# SHIFT moves co-located non-SHIFT objects one tile in the SHIFT object's facing direction.

[setup]
version 1
name "shift carries co-located object"

text 0 0 rock
text 1 0 is
text 2 0 shift

text 0 1 baba
text 1 1 is
text 2 1 you

object 5 5 rock right
object 5 5 baba right

[inputs]
input wait

[expected]
at 6 5 baba
not_at 5 5 baba
at 5 5 rock
tick 1
not_won
