# BABA FEAR KEKE AND FLAG: baba fears both keke (right) and flag (left).
# Baba at (5,5) facing right. Keke at (6,5), flag at (4,5).
# Right=feared(keke), left=feared(flag). Next: CW of right = down -> free -> baba at (5,6).

[setup]
version 1
name "baba fears both keke and flag via and chain"

text 0 0 baba
text 1 0 fear
text 2 0 keke
text 3 0 and
text 4 0 flag

object 5 5 baba right
object 6 5 keke right
object 4 5 flag right

[inputs]
input wait

[expected]
at 5 6 baba
not_at 5 5 baba
tick 1
not_won
