# BABA FEAR KEKE: keke shares the same tile as baba.
# Same-tile feared objects do not trigger movement (only adjacent tiles checked).

[setup]
version 1
name "baba does not fear keke on same tile"

text 0 0 baba
text 1 0 fear
text 2 0 keke

object 5 5 baba right
object 5 5 keke right

[inputs]
input wait

[expected]
at 5 5 baba
tick 1
not_won
