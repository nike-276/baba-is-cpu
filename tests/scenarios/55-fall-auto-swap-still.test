# This tests several things:
# 1. A SWAP object can move into a STOP.
# 2. A STILL STOP will not be moved by a SWAP
# 3. An object can move out of a STOP

[setup]
version 1
name "fall auto swap still"

text 0 0 baba
text 1 0 is
text 2 0 auto
text 0 1 baba
text 1 1 on
text 2 1 keke
text 3 1 is
text 4 1 fall
text 0 2 baba
text 1 2 on
text 2 2 flag
text 3 2 is
text 4 2 swap
text 0 3 wall
text 1 3 is
text 2 3 stop
text 3 3 and
text 4 3 still

object 10 10 baba down
object 10 10 keke right
object 10 20 flag right
object 10 21 wall right

[inputs]
input right
input right
input right

[expected]
at 10 21 wall
at 10 22 baba
at 10 20 flag
tick 3
not_won
