# BABA NOT ON SKULL IS YOU: baba loses YOU when sharing a tile with skull.
# Baba and skull start on the same tile, so the NOT ON condition fails —
# baba has no YOU and cannot move.

[setup]
version 1
name "not-on: baba on skull loses YOU and cannot move"

text 0 0 baba
text 1 0 not
text 2 0 on
text 3 0 skull
text 4 0 is
text 5 0 you

object 5 5 baba right
object 5 5 skull right

[inputs]
input right

[expected]
count baba 1
at 5 5 baba
not_won
