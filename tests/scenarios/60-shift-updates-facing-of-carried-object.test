# When SHIFT carries an object, that object's facing updates to the shift direction.
# Rock (SHIFT, facing right) carries Baba left — wait, rock faces right so baba goes right.
# After SHIFT carries baba right, baba should face right (which it already does here).
# To test direction change: rock faces left, baba starts facing right; baba should face left after carry.

[setup]
version 1
name "shift: carried object facing updates to shift direction"

text 0 0 rock
text 1 0 is
text 2 0 shift
text 3 0 and
text 4 0 left

text 0 1 baba
text 1 1 is
text 2 1 you

object 5 5 rock right
object 5 5 baba right

[inputs]
input wait

[expected]
at 4 5 baba
not_at 5 5 baba
tick 1
not_won
