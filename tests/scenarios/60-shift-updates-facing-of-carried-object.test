# When SHIFT carries an object, DIRECTIONAL runs AFTER movement (Phase 2.8).
# Rock starts facing right, baba is on same tile. SHIFT moves baba right to (6,5).
# Then DIRECTIONAL sets rock facing left — takes effect next tick, not this one.

[setup]
version 1
name "shift: carried object facing updates to shift direction"

text 0 0 rock
text 1 0 is
text 2 0 shift
text 3 0 and
text 4 0 left

text 0 1 baba
text 1 1 is
text 2 1 you

object 5 5 rock right
object 5 5 baba right

[inputs]
input wait

[expected]
at 6 5 baba
not_at 5 5 baba
tick 1
not_won
