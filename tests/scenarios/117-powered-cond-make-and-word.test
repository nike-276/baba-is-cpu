# Combines WORD, POWERED conditional EAT, and POWERED conditional MAKE in one tick.
#
# Rules (text tiles):
#   CLOCK IS AUTO
#   BANANA IS AUTO
#   CLOCK ON FLAG IS POWER
#   BANANA ON GEM IS WORD
#   POWERED BABA ON BOX EAT PIZZA
#   POWERED BABA ON FLAG MAKE  [banana-obj-on-gem acts as BANANA text]
#
# The last rule strip is: text "powered baba on flag make" at (0-4,3),
# then a gem object at (5,3).  A banana object at (5,2) faces down.
#
# Tick 1:
#   AUTO: clock moves right onto flag  →  POWER active.
#         banana moves down onto gem   →  BANANA ON GEM IS WORD fires,
#                                         banana acts as BANANA text.
#   Post-move parse: "powered baba on flag make [banana=BANANA]"
#                    forms POWERED BABA ON FLAG MAKE BANANA.
#   EAT : POWERED BABA ON BOX EAT PIZZA fires  →  pizza destroyed.
#   MAKE: POWERED BABA ON FLAG MAKE BANANA fires  →  banana spawned at baba's tile.
#
# Tick 2:
#   AUTO: clock moves right off flag  →  POWER gone.
#         original banana moves down off gem  →  WORD gone, make rule gone.
#         new banana (at baba tile, facing right) moves right.

[setup]
version 1
name "word+powered: conditional EAT then MAKE in same tick"

text 0 0 clock
text 1 0 is
text 2 0 auto

text 4 0 banana
text 5 0 is
text 6 0 auto

text 0 1 clock
text 1 1 on
text 2 1 flag
text 3 1 is
text 4 1 power

text 6 1 banana
text 7 1 on
text 8 1 gem
text 9 1 is
text 10 1 word

text 0 2 powered
text 1 2 baba
text 2 2 on
text 3 2 box
text 4 2 eat
text 5 2 pizza

text 0 3 powered
text 1 3 baba
text 2 3 on
text 3 3 flag
text 4 3 make

object 5 2 banana down
object 5 3 gem right

object 0 7 clock right
object 1 7 flag right

object 5 7 baba right
object 5 7 box right
object 5 7 pizza right
object 5 7 flag right

[inputs]
input right
input right

[expected]
tick 2
at 2 7 clock
at 1 7 flag
at 5 4 banana
at 6 7 banana
at 5 7 baba
at 5 7 box
at 5 7 flag
not_at 5 7 pizza
not_at 5 7 banana
not_at 5 3 banana
