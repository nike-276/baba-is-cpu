# Two SHIFT-right objects on the same tile stack: baba on the tile moves two
# tiles to the right in a single SHIFT substage.

[setup]
version 1
name "shift stacks: two same-direction shifters = 2 moves"

text 0 0 rock
text 1 0 is
text 2 0 shift

text 0 1 baba
text 1 1 is
text 2 1 you

object 5 5 rock right
object 5 5 rock right
object 5 5 baba right

[inputs]
input wait

[expected]
at 7 5 baba
not_at 5 5 baba
not_at 6 5 baba
tick 1
not_won
