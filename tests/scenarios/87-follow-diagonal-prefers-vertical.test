# BABA FOLLOW FLAG: flag at (7,3), baba at (5,5). dx=2, dy=-2 (equal magnitude).
# Tie-break prefers vertical: dy<0 -> up. Baba moves up to (5,4).

[setup]
version 1
name "baba follow diagonal target prefers vertical movement"

text 0 0 baba
text 1 0 follow
text 2 0 flag

object 5 5 baba right
object 7 3 flag right

[inputs]
input wait

[expected]
at 5 4 baba
not_at 5 5 baba
tick 1
not_won
