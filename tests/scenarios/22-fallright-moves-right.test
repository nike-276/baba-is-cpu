# FALLRIGHT: rock moves right every tick regardless of facing.
# Rock at (0,0) facing down. After one tick should be at (1,0).

[setup]
version 1
name "fallright moves right"

text 0 3 rock
text 1 3 is
text 2 3 fallright

object 0 0 rock down

[inputs]
wait

[expected]
at 1 0 rock
not_at 0 0 rock
not_won
