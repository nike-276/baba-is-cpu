# BABA FOLLOW FLAG: baba at (5,5), flag at (8,5). Baba moves one tile
# toward the nearest flag (right) ending at (6,5).

[setup]
version 1
name "baba follows flag - moves one tile toward it"

text 0 0 baba
text 1 0 follow
text 2 0 flag

object 5 5 baba right
object 8 5 flag right

[inputs]
input wait

[expected]
at 6 5 baba
not_at 5 5 baba
tick 1
not_won
