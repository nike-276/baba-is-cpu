# BABA FOLLOW FLAG: two flags at (3,5) dist=2 and (8,5) dist=3.
# Baba at (5,5) follows the nearest flag, moving left to (4,5).

[setup]
version 1
name "baba follows nearest flag when two exist"

text 0 0 baba
text 1 0 follow
text 2 0 flag

object 5 5 baba right
object 3 5 flag right
object 8 5 flag right

[inputs]
input wait

[expected]
at 4 5 baba
not_at 5 5 baba
tick 1
not_won
