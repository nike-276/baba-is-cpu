# BABA FACEDBY KEKE IS WIN: baba does NOT win when keke faces away from baba.
# Keke is one tile to the left of baba, but faces left — aimed at (3,5), not baba.

[setup]
version 1
name "facedby condition: facing away = no win"

text 0 0 baba
text 1 0 facedby
text 2 0 keke
text 3 0 is
text 4 0 win

text 0 1 baba
text 1 1 is
text 2 1 you

object 5 5 baba right
object 4 5 keke left

[inputs]
input wait

[expected]
not_won
