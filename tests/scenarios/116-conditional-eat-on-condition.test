# BEAN ON BEAN EAT WALL: when two beans are on the same tile, they eat walls
# co-located with them. With only one bean, the condition is not satisfied and
# the wall survives.
# Bug: conditional EAT was not parsed or evaluated at all.

[setup]
version 1
name "conditional eat: bean on bean eats wall"

text 0 0 bean
text 1 0 on
text 2 0 bean
text 3 0 eat
text 4 0 wall

text 0 1 wall
text 1 1 is
text 2 1 stop

text 0 2 baba
text 1 2 is
text 2 2 you

object 5 5 bean right
object 5 5 bean right
object 5 5 wall right

[inputs]
input wait

[expected]
count wall 0
count bean 2
not_won
