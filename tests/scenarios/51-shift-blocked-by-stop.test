# SHIFT cannot carry an object into a tile blocked by STOP.

[setup]
version 1
name "shift respects stop in target tile"

text 0 0 rock
text 1 0 is
text 2 0 shift

text 0 1 wall
text 1 1 is
text 2 1 stop

text 0 2 baba
text 1 2 is
text 2 2 you

object 5 5 rock right
object 5 5 baba right
object 6 5 wall right

[inputs]
input wait

[expected]
at 5 5 baba
not_at 6 5 baba
tick 1
not_won
