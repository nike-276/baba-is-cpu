# BABA NOT ON ROCK AND ON WALL IS YOU: compound condition — NOT ON ROCK (forbidden)
# AND ON WALL (required).  Baba starts with no rock or wall on its tile, so the
# ON WALL required condition fails and baba has no YOU.

[setup]
version 1
name "not-on plus on compound: no you when required noun absent"

text 0 0 baba
text 1 0 not
text 2 0 on
text 3 0 rock
text 4 0 and
text 5 0 on
text 6 0 wall
text 7 0 is
text 8 0 you

object 5 5 baba right

[inputs]
input right

[expected]
count baba 1
at 5 5 baba
not_won
