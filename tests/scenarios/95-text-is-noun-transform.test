# TEXT IS BABA: all text tiles become non-text baba objects.
# "text rock" at 5,5 should transform into a non-text baba object.
# The rule tiles themselves also transform, confirming TEXT matches all text objects.

[setup]
version 1
name "text is baba: text tiles become non-text baba"

text 0 0 text
text 1 0 is
text 2 0 baba

text 5 5 rock

[inputs]
input wait

[expected]
at 5 5 baba
not_at 5 5 rock
not_won
