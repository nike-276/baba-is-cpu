# A SWAP mover exchanges positions with whatever object is in its target tile.

[setup]
version 1
name "swap mover exchanges with any object"

text 0 0 baba
text 1 0 is
text 2 0 you
text 3 0 and
text 4 0 swap

object 5 5 baba right
object 6 5 rock right

[inputs]
input right

[expected]
at 6 5 baba
at 5 5 rock
not_at 5 5 baba
not_at 6 5 rock
tick 1
not_won
