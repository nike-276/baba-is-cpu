# BABA FACING FLAG IS WIN: baba wins when the tile immediately ahead contains a flag.
# Baba faces right; flag is one tile to the right. Input wait — no movement needed.

[setup]
version 1
name "facing condition: facing flag grants win"

text 0 0 baba
text 1 0 facing
text 2 0 flag
text 3 0 is
text 4 0 win

text 0 1 baba
text 1 1 is
text 2 1 you

object 5 5 baba right
object 6 5 flag right

[inputs]
input wait

[expected]
won
