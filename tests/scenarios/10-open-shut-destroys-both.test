# Scenario 10: OPEN and SHUT destroy each other when co-located.
# Key (OPEN) and door (SHUT) start on the same tile; a wait tick triggers DESTRUCT.

[setup]
version 1
name "open shut destroys both"

text 0 0 baba
text 1 0 is
text 2 0 you

text 0 1 key
text 1 1 is
text 2 1 open

text 0 2 door
text 1 2 is
text 2 2 shut

object 5 5 baba right
object 10 10 key right
object 10 10 door right

[inputs]
wait

[expected]
count key 0
count door 0
tick 1
not_won
