# DONUT ON SIGN PLAY A: donut only emits the note when co-located with a sign.
# Donut on sign → sound_count 1. Lone donut (no sign) → sound_count 0.

[setup]
version 1
name "conditional play fires when ON condition met"

text 0 0 donut
text 1 0 on
text 2 0 sign
text 3 0 play
text 4 0 a

text 0 1 baba
text 1 1 is
text 2 1 you

object 5 5 donut right
object 5 5 sign right

object 8 5 donut right

[inputs]
input wait

[expected]
sound_count 1
tick 1
not_won
