# BEE ON TILE IS ARM, BEE ON TILE IS BRAIN, ARM IS REVERT, BRAIN IS REVERT
# Tick 1: bee+tile → arm+brain (split). Tick 2: arm+brain → bee+bee (revert).
# Tick 3: two bees on tile → 2 arms + 2 brains.

[setup]
version 1
name "revert: split objects remember original kind"

text 0 0 bee
text 1 0 on
text 2 0 tile
text 3 0 is
text 4 0 arm

text 0 1 bee
text 1 1 on
text 2 1 tile
text 3 1 is
text 4 1 brain

text 0 2 arm
text 1 2 is
text 2 2 revert

text 0 3 brain
text 1 3 is
text 2 3 revert

text 0 4 baba
text 1 4 is
text 2 4 you

object 5 5 bee right
object 5 5 tile right

[inputs]
input wait

[expected]
count arm 1
count brain 1
count bee 0
count tile 1
not_won
