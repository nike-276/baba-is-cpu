# CART NOT ON TRACK AND BABA IS AUTO: cart has AUTO only when BOTH track and baba
# are absent from its tile.  AND distributes over NOT ON, so each noun independently
# must be absent.
# Here cart is ON track → NOT ON TRACK fails → no AUTO → cart cannot move.

[setup]
version 1
name "not-on compound: cart on track lacks AUTO because track is present"

text 0 0 cart
text 1 0 not
text 2 0 on
text 3 0 track
text 4 0 and
text 5 0 baba
text 6 0 is
text 7 0 auto

object 5 5 track right
object 5 5 cart right
object 9 9 baba right

[inputs]
input right

[expected]
count cart 1
at 5 5 cart
not_won
