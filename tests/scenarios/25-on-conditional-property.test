# BABA ON ROCK IS YOU: baba has YOU only while sharing a tile with rock.
# Baba and rock share (2,2). No standalone BABA IS YOU rule.
# FLAG IS WIN. Player input right → baba moves to (3,2) because it had YOU during
# PARSE_INITIAL (on rock), but after moving it is no longer on the rock so loses YOU.
# Rock does NOT move — it was never independently YOU.
# At CHECK_WIN time (PARSE_POST_DESTRUCT) there is no YOU → not_won.

[setup]
version 1
name "on conditional property"

text 0 0 baba
text 1 0 on
text 2 0 rock
text 3 0 is
text 4 0 you
text 0 1 flag
text 1 1 is
text 2 1 win

object 2 2 baba right
object 2 2 rock right
object 3 2 flag right

[inputs]
input right

[expected]
count baba 1
at 3 2 baba
at 2 2 rock
not_won
